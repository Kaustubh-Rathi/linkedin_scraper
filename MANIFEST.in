# Package documentation
include README.md
include LICENSE
include CONTRIBUTING.md
include TESTING.md
include CHANGELOG.md
include .env.example

# Include all Python files and typing marker in the package
recursive-include linkedin_scraper *.py
recursive-include linkedin_scraper py.typed

# Exclude build, test, and cache files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *$py.class
global-exclude *.so
global-exclude .DS_Store

prune tests
prune build
prune dist
prune *.egg-info
prune venv
prune .venv
prune .pytest_cache
prune .git
